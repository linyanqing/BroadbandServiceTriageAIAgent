# Copy to .env for local development. Never commit a real .env file.

# --- Core ---
ENVIRONMENT=local
AGENT_VERSION=0.1.0

# MOCK_MODE governs Bedrock + AI-observability mocking only. The eleven
# enterprise tools (across all four specialists) are always deterministic
# in-process mocks in this POC.
MOCK_MODE=true

# --- Bedrock (required only when MOCK_MODE=false; no hard-coded default) ---
# Example model ID, not a default value -- pick a Bedrock model in your
# account/region that supports tool/function calling.
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_REGION=ap-southeast-2

# --- Human-in-the-loop policy ---
# false (default) = every high-risk action pauses for approval.
# true = auto-approve high-risk actions across all four specialists (fast demo).
AUTO_APPROVE_HIGH_RISK=false
MAX_ITERATIONS=8              # per-specialist tool-call ceiling
MAX_SPECIALIST_DISPATCHES=6   # supervisor-level ceiling; see config.py's comment

# --- LangSmith (AI-specific tracing/evaluation) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=broadband-triage-agent
# LANGCHAIN_API_KEY=            # set via Secrets Manager/SSM in deployed envs, never committed
# LANGCHAIN_ENDPOINT=           # only set for a non-default-region LangSmith account
#                                # (e.g. https://apac.api.smith.langchain.com) -- a key
#                                # authenticates ONLY against the region it was issued in
#                                # and otherwise returns 403 Forbidden on every request

# --- OpenTelemetry (enterprise telemetry -> ADOT Collector -> Cribl -> Datadog/Splunk) ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
