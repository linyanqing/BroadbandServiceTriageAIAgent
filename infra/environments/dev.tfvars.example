# Copy to dev.tfvars (kept out of git -- see .gitignore) and fill in your
# account's actual values. Never commit a real .tfvars file.

project_name = "broadband-triage-agent"
environment  = "dev"
aws_region   = "ap-southeast-2"

vpc_id              = "vpc-xxxxxxxx"
public_subnet_ids   = ["subnet-aaaaaaa", "subnet-bbbbbbb"]
private_subnet_ids  = ["subnet-ccccccc", "subnet-ddddddd"]

# true only if private_subnet_ids above have no NAT gateway (e.g. they're
# actually the default VPC's public subnets, reused here for a low-cost POC).
# Leave false for a real private-subnet-with-NAT topology.
assign_public_ip = false

# Bootstrap order: `terraform apply -target=module.ecr` first, then
# `docker push` to the resulting repository_url, THEN fill this in and run a
# full apply -- the ECS service will fail to start if the tag doesn't exist yet.
container_image  = "123456789012.dkr.ecr.ap-southeast-2.amazonaws.com/broadband-triage-agent:latest"
bedrock_model_id = "anthropic.claude-3-5-sonnet-20241022-v2:0"

auto_approve_high_risk   = false
langsmith_tracing_enabled = false
langsmith_project        = "broadband-triage-agent"
# Only set this if your LangSmith account is on a non-default regional
# deployment (e.g. APAC) -- a key issued there authenticates ONLY against
# that region's host and returns 403 Forbidden against the default US one.
# Check with: curl -H "x-api-key: $KEY" https://apac.api.smith.langchain.com/api/v1/sessions?limit=1
langsmith_endpoint = ""

cribl_otlp_endpoint = "https://cribl.example.internal:10080"
alarm_sns_topic_arn = ""
